# Required: supply your own account and destination. Never commit this file with secrets.
DISCORD_TOKEN=
DISCORD_USER_ID=
DISCORD_USERNAME=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Local state. Use one directory per account/channel; do not share it between senders.
DISCORD_AUTOREPLY_DATA_DIR=.runtime

# Use an existing, authorized Hermes provider configuration.
HERMES_MODEL=gpt-6-astra
HERMES_PROVIDER=custom:api.xingchiapi.com

# Optional operator-confirmed fact. Empty means unknown; no country is assumed.
DISCORD_COUNTRY_OF_ORIGIN=
